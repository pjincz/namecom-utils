#!/usr/bin/env python3
"""Small Name.com CLI; requires only Python 3's standard library."""

import argparse
import base64
import configparser
import json
import sys
import urllib.error
import urllib.parse
import urllib.request


API_URL = "https://api.name.com/core/v1"


class Error(Exception):
    pass


def normalize_name(name):
    return name.rstrip(".").lower()


def load_config(path):
    config = configparser.ConfigParser(interpolation=None)
    try:
        with open(path, encoding="utf-8") as stream:
            config.read_file(stream)
    except OSError:
        raise Error(f"Cannot read configuration: {path}") from None
    except (configparser.Error, UnicodeError):
        # ConfigParser errors can contain source lines, including credentials.
        raise Error(f"Invalid INI configuration: {path}") from None

    return config


def load_account(path, name):
    config = load_config(path)
    matches = [
        (normalize_name(section), section) for section in config.sections()
        if normalize_name(section)
        and (name == normalize_name(section)
             or name.endswith("." + normalize_name(section)))
    ]
    if not matches:
        raise Error(f"No configured domain matches {name}")
    domain, section = max(matches, key=lambda item: len(item[0]))
    username = config.get(section, "username", fallback="").strip()
    token = config.get(section, "token", fallback="").strip()
    if not username or not token:
        raise Error(f"Configuration [{section}] requires username and token")
    return domain, username, token


def api_request(url, username, token, payload=None, method=None):
    authorization = base64.b64encode(
        f"{username}:{token}".encode("utf-8")
    ).decode("ascii")
    headers = {"Authorization": f"Basic {authorization}",
               "Accept": "application/json"}
    body = None
    if payload is not None:
        body = json.dumps(payload).encode("utf-8")
        headers["Content-Type"] = "application/json"
    request = urllib.request.Request(url, data=body, headers=headers, method=method)
    try:
        with urllib.request.urlopen(request, timeout=30) as response:
            if method == "DELETE":
                return None
            return json.load(response)
    except urllib.error.HTTPError as exc:
        raise Error(f"Name.com API returned HTTP {exc.code}") from None
    except (urllib.error.URLError, OSError):
        raise Error("Name.com request failed (network error or timeout)") from None
    except (ValueError, UnicodeError):
        raise Error("Name.com API returned invalid JSON") from None


def get_records(domain, username, token, name=None, record_type=None, include_id=False):
    result = []
    page = 1
    while True:
        query = urllib.parse.urlencode({"page": page, "perPage": 1000})
        url = f"{API_URL}/domains/{urllib.parse.quote(domain, safe='')}/records?{query}"
        data = api_request(url, username, token)

        try:
            for record in data.get("records", []):
                host = record.get("host", "")
                fqdn = record.get("fqdn") or (
                    domain if host in ("", "@") else f"{host}.{domain}"
                )
                if ((name is None or normalize_name(fqdn) == name)
                        and (record_type is None or record["type"].upper() == record_type)):
                    value = record["answer"]
                    if not isinstance(value, str):
                        raise ValueError
                    result.append({"name": normalize_name(fqdn), "type": record["type"].upper(),
                                   "value": value, "ttl": record["ttl"]})
                    if name is None and "priority" in record:
                        result[-1]["priority"] = record["priority"]
                    if include_id:
                        record_id = record["id"]
                        if type(record_id) is not int or record_id <= 0:
                            raise ValueError
                        result[-1]["id"] = record_id
            next_page = data.get("nextPage")
            if not next_page:
                return result
            if not isinstance(next_page, int) or next_page <= page:
                raise ValueError
            page = next_page
        except (AttributeError, KeyError, TypeError, ValueError):
            raise Error("Name.com API returned an invalid records response") from None


def add_record(domain, username, token, name, record_type, value, ttl):
    host = "" if name == domain else name[:-(len(domain) + 1)]
    url = f"{API_URL}/domains/{urllib.parse.quote(domain, safe='')}/records"
    api_request(url, username, token, {
        "host": host, "type": record_type, "answer": value, "ttl": ttl,
    })
    print(f"Added: {record_type} {name} {json.dumps(value, ensure_ascii=False)} (TTL {ttl})",
          file=sys.stderr)


def delete_records(domain, username, token, name, record_type):
    # Finish pagination before deleting so records cannot shift between pages.
    records = get_records(domain, username, token, name, record_type, include_id=True)
    if not records:
        print(f"No matching records: {record_type} {name}", file=sys.stderr)
    for record in records:
        url = (f"{API_URL}/domains/{urllib.parse.quote(domain, safe='')}/records/"
               f"{record['id']}")
        api_request(url, username, token, method="DELETE")
        print(f"Deleted: {record_type} {name} {json.dumps(record['value'], ensure_ascii=False)}",
              file=sys.stderr)


def set_record(domain, username, token, name, record_type, value, ttl):
    url = f"{API_URL}/domains/{urllib.parse.quote(domain, safe='')}/records"
    host = "" if name == domain else name[:-(len(domain) + 1)]
    while True:
        records = get_records(domain, username, token, name, record_type, include_id=True)
        if len(records) > 1:
            record = records[-1]
            api_request(f"{url}/{record['id']}", username, token, method="DELETE")
            print(f"Deleted: {record_type} {name} {json.dumps(record['value'], ensure_ascii=False)}",
                  file=sys.stderr)
            continue

        effective_ttl = ttl if ttl is not None else (records[0]["ttl"] if records else 300)
        if records and records[0]["value"] == value and records[0]["ttl"] == effective_ttl:
            print(f"Already matches, skipped: {record_type} {name} {json.dumps(value, ensure_ascii=False)} (TTL {effective_ttl})",
                  file=sys.stderr)
            return
        payload = {"host": host, "type": record_type, "answer": value, "ttl": effective_ttl}
        if records:
            api_request(f"{url}/{records[0]['id']}", username, token, payload, method="PUT")
            action = "Updated"
        else:
            api_request(url, username, token, payload)
            action = "Added"
        print(f"{action}: {record_type} {name} {json.dumps(value, ensure_ascii=False)} (TTL {effective_ttl})",
              file=sys.stderr)
        return


def parse_ttl(value):
    try:
        ttl = int(value)
    except ValueError:
        raise argparse.ArgumentTypeError("TTL must be an integer") from None
    if not 300 <= ttl <= 4294967295:
        raise argparse.ArgumentTypeError("TTL must be between 300 and 4294967295 seconds")
    return ttl


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--config", default="/etc/namecom.ini", metavar="PATH",
                        help="INI configuration (default: /etc/namecom.ini)")
    commands = parser.add_subparsers(dest="command", required=True)
    get = commands.add_parser("get", help="Print matching DNS record values")
    add = commands.add_parser("add", help="Add a record without checking for duplicates")
    delete = commands.add_parser("del", help="Delete all records matching name and type")
    set_command = commands.add_parser("set", help="Replace matching records with a single record")
    list_command = commands.add_parser("list", help="List all records in a configured domain zone")
    list_command.add_argument("name", nargs="?", metavar="DOMAIN",
                              help="Configured zone (default: all configured zones)")
    list_command.add_argument("--json", action="store_true", help="Print record objects as JSON")
    list_command.add_argument("--config", default=argparse.SUPPRESS, metavar="PATH",
                              help="INI configuration (default: /etc/namecom.ini)")
    for command in (get, add, delete, set_command):
        command.add_argument("type", type=str.upper, choices=("A", "AAAA", "CNAME", "TXT"))
        command.add_argument("name", help="Full record name, including the domain")
        command.add_argument("--config", default=argparse.SUPPRESS, metavar="PATH",
                             help="INI configuration (default: /etc/namecom.ini)")
    get.add_argument("--json", action="store_true", help="Print record objects as JSON")
    add.add_argument("value", help="Record value")
    add.add_argument("--ttl", type=parse_ttl, default=300, metavar="SECONDS",
                     help="Time to live, at least 300 seconds (default: 300)")
    set_command.add_argument("value", help="New record value")
    set_command.add_argument("--ttl", type=parse_ttl, metavar="SECONDS",
                     help="Time to live (default: preserve existing TTL, or 300 for a new record)")
    args = parser.parse_args(argv)
    name = normalize_name(args.name) if args.name is not None else None
    try:
        if args.command == "list":
            zones = [name] if name is not None else list(dict.fromkeys(
                normalize_name(section) for section in load_config(args.config).sections()
            ))
            records = []
            for zone in zones:
                domain, username, token = load_account(args.config, zone)
                if zone != domain:
                    raise Error(f"Use the configured zone name: {domain}")
                records.extend(get_records(domain, username, token, include_id=True))
        else:
            domain, username, token = load_account(args.config, name)
        if args.command == "add":
            add_record(domain, username, token, name, args.type, args.value, args.ttl)
            return 0
        if args.command == "del":
            delete_records(domain, username, token, name, args.type)
            return 0
        if args.command == "set":
            set_record(domain, username, token, name, args.type, args.value, args.ttl)
            return 0
        if args.command == "get":
            records = get_records(domain, username, token, name, args.type)
    except Error as exc:
        print(f"namecom: {exc}", file=sys.stderr)
        return 1
    if args.json:
        print(json.dumps(records, ensure_ascii=False, indent=2))
    elif args.command == "list":
        for record in records:
            priority = f" priority={record['priority']}" if "priority" in record else ""
            print(f"{record['name']}\t{record['type']}\t"
                  f"{json.dumps(record['value'], ensure_ascii=False)}\tTTL={record['ttl']}{priority}")
    else:
        for record in records:
            print(record["value"])
    return 0


if __name__ == "__main__":
    sys.exit(main())
